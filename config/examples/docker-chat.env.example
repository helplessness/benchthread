# 复制到 .tcode-local/docker-chat/settings.env，不要提交真实配置。
# 首次启动必填：设置至少 12 字符的独立管理员密码。
# 值包含 $、空格或 # 时保留外层单引号。
TCODE_BOOTSTRAP_PASSWORD=''
# TCODE_BOOTSTRAP_EMAIL='admin@example.com'

# 必填：容器能够访问的模型 API 基础地址，不要追加 /chat/completions。
TCODE_DEMO_BASE_URL='https://your-provider.example/v1'
# 模型服务要求鉴权时填真实密钥；无鉴权的兼容接口可填 'local'。
TCODE_DEMO_API_KEY=''
